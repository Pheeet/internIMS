generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String?
  role                 Role
  status               UserStatus      @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  internship_submitted Boolean         @default(false)
  is_first_login       Boolean         @default(true)
  profile_completed    Boolean         @default(false)
  adminProfile         AdminProfile?
  attachments          Attachment[]
  auditLogsActioned    AuditLog[]      @relation("ActionBy")
  auditLogsTargeted    AuditLog[]      @relation("TargetUser")
  internships          Internship[]
  internshipsUpdated   Internship[]    @relation("UpdatedByAdmin")
  studentProfile       StudentProfile?
  works                Work[]          @relation("StudentWorks")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model AdminProfile {
  userId        String   @id
  firstNameTh   String?
  lastNameTh    String?
  phoneNumber   String?
  positionTitle String?
  department    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentProfile {
  userId               String    @id
  profilePictureUrl    String?
  prefix               String
  firstNameTh          String
  lastNameTh           String
  gender               String?
  dob                  DateTime?
  phoneNumber          String?
  emergencyPhone       String?
  contactAddress       String?
  educationLevel       String?
  institution          String?
  faculty              String?
  major                String?
  advisorName          String?
  advisorPhone         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  guardianName         String?
  guardianRelationship String?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Internship {
  id               String           @id @default(uuid())
  studentId        String
  position         String
  department       String?
  company          String?
  supervisorName   String?
  startDate        DateTime
  endDate          DateTime
  status           InternshipStatus @default(PENDING)
  remarks          String?
  updatedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  flaggedFields    Json?
  previousSnapshot Json?
  attachments      Attachment[]
  student          User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedByAdmin   User?            @relation("UpdatedByAdmin", fields: [updatedBy], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([updatedBy])
}

model Attachment {
  id           String           @id @default(uuid())
  studentId    String
  internshipId String?
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedAt   DateTime         @default(now())
  rejectReason String?
  status       AttachmentStatus @default(PENDING)
  internship   Internship?      @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([internshipId])
}

model Work {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int
  studentId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     User     @relation("StudentWorks", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actionBy     String
  actionType   String
  resourceType String?
  resourceId   String?
  targetUserId String?
  oldValue     String?
  newValue     String?
  description  String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actionByUser User     @relation("ActionBy", fields: [actionBy], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])

  @@index([actionBy])
  @@index([targetUserId])
  @@index([actionType])
  @@index([createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InternshipStatus {
  PENDING
  REJECTED
  EDIT_REQUESTED
  APPROVED
  COMPLETED
}

enum AttachmentStatus {
  PENDING
  APPROVED
  REJECTED
}
