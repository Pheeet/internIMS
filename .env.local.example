# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Internship Management System"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# First Super Admin Setup
SUPER_ADMIN_EMAIL="admin@cmu.ac.th"
SUPER_ADMIN_PASSWORD="secure-password-here"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL=http://localhost:3000
SESSION_TIMEOUT=86400000

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# CMU OAuth (Entra ID)
# -----------------------------------------------------------------------------
CMU_CLIENT_ID="your-cmu-client-id"
CMU_CLIENT_SECRET="your-cmu-client-secret"
CMU_REDIRECT_URI=http://localhost:3000/intern/api/auth/callback
CMU_OAUTH_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/authorize
CMU_TOKEN_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/token
CMU_USERINFO_URL=https://api.cmu.ac.th/mis/cmuaccount/prod/v3/me/basicinfo
CMU_SCOPE="openid profile email"

# -----------------------------------------------------------------------------
# Telegram Notification
# -----------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your-bot-token"
# Chat ID from @userinfobot or your group chat
TELEGRAM_CHAT_ID="your-chat-id"

# -----------------------------------------------------------------------------
# Cron Jobs
# -----------------------------------------------------------------------------
# Secret to protect cron endpoints (e.g. /api/cron/*)
# Send this in the Authorization header as: Bearer <CRON_SECRET>
CRON_SECRET="your-cron-secret"
